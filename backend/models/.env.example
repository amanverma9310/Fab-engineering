# ==== Server ====
PORT=5000
NODE_ENV=development

# ==== Database ====
MONGODB_URI=mongodb+srv://Amanvermav89900:Amanverma9900@cluster0.rvmvyac.mongodb.net/fabworks?appName=Cluster0
JWT_SECRET=x7K9pQ2vN4mR8tL1wZ6cF3hB5sJ0yA
JWT_EXPIRES_IN=7d


# ==== CORS (must match your deployed frontend origin exactly) ====
CORS_ORIGIN=http://localhost:5173

# ==== Email notifications (optional — inquiries/contact still save to DB if unset) ====
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
# Where new inquiry/contact/quote notifications are sent
NOTIFY_EMAIL=

# ==== File storage ====
# Leave the Cloudinary vars blank to use local disk storage (backend/uploads/)
# for development. Set all three to automatically switch to Cloudinary,
# which is required in production (most hosts like Render/Railway do not
# persist a local filesystem between deploys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==== First admin account (used only by `npm run create-admin`) ====
ADMIN_NAME=Admin
ADMIN_EMAIL=owner@fabengineering.example
ADMIN_PASSWORD=Amanverma@9900

# ==== Emergency password reset (used only by `npm run reset-admin-password`) ====
# Only needed if you're locked out and can't log in to use Admin -> Account.
# Fill these in, run the script once, then clear them again.
RESET_ADMIN_EMAIL=
RESET_ADMIN_NEW_PASSWORD=
